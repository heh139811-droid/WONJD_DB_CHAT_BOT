# ─────────────────────────────────────────────
# WONJD_DB_CHAT_BOT — 환경변수
# 이 파일을 .env 로 복사해서 채운다. .env 는 커밋되지 않는다.
#   cp .env.example .env
# ─────────────────────────────────────────────

# --- SSH 터널 (bastion) ---
SSH_HOST=                    # 예: bastion.example.com  (사내 SSH 서버 주소)
SSH_PORT=22
SSH_USER=                    # SSH 계정
SSH_PASSWORD=                # 비밀번호 인증을 쓸 때. 키를 쓰면 비워두고 SSH_KEY_PATH 사용
SSH_KEY_PATH=                # 예: C:/Users/PC/.ssh/id_rsa  (있으면 비밀번호보다 우선)
SSH_KEY_PASSPHRASE=          # 키에 암호가 걸려 있을 때만

# 터널이 로컬에 열어줄 입구. 이 포트로 접속하면 원격 DB로 연결된다.
SSH_LOCAL_BIND_HOST=127.0.0.1
SSH_LOCAL_BIND_PORT=13306

# --- DB (SSH 서버에서 바라본 주소) ---
# DB가 bastion 자기 자신에 있으면 127.0.0.1, 별도 DB 서버면 그 내부 주소.
DB_REMOTE_HOST=127.0.0.1
DB_REMOTE_PORT=3306
DB_NAME=crm
DB_USER=                     # read-only 계정
DB_PASSWORD=

DB_QUERY_TIMEOUT_SEC=30
DB_MAX_ROWS=1000
DB_MAX_ROWS_TO_LLM=100

# --- Hermes (npm run start:all) ---
HERMES_WORKSPACE=C:/Users/PC/Documents/hermes-workspace
HERMES_WORKSPACE_DIR=C:/Users/PC/Documents/wireframe_dashboard
HERMES_API_URL=http://127.0.0.1:8642
